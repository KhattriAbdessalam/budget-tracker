generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id        String   @id @default(cuid())
  label     String
  amount    Float
  type      String   // "expense" ou "income"
  category  String   // Nouvelle colonne : ex: "Alimentation", "Logement", "Loisirs"...
  date      DateTime // Nouvelle colonne : La date réelle choisie sur le calendrier
  createdAt DateTime @default(now()) // On garde ça uniquement pour savoir quand la ligne a été créée techniquement
}

model RecurringTransaction {
  id          String   @id @default(uuid())
  amount      Float    // Positif pour un salaire, négatif pour un prélèvement (ex: -30.00 pour la box)
  type        String   // Optionnel, mais pratique : "INCOME" ou "EXPENSE"
  description String
  dayOfMonth  Int
  userId      String
  createdAt   DateTime @default(now())
}